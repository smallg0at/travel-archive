# Azure AD app registration (public client / native app, no secret).
# Register at https://portal.azure.com -> App registrations -> New registration.
# Supported account types: "Personal Microsoft accounts only" (or add org accounts if needed).
# Under Authentication, enable "Allow public client flows" (needed for device code flow).
AZURE_CLIENT_ID=
AZURE_TENANT_ID=consumers

# Which AI provider implements captioning + day summaries. See
# pipeline/src/providers/ — currently only "gemini". Add another provider by
# implementing pipeline/src/providers/types.ts's AiProvider interface and
# wiring it into pipeline/src/providers/index.ts.
AI_PROVIDER=gemini

# Gemini. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# DeepSeek (used when AI_PROVIDER=deepseek). Get a key at https://platform.deepseek.com
# `deepseek-flash` is the image-capable Flash; `deepseek-v4-flash` is text-only.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# OneDrive folder paths (relative to drive root), no leading slash.
# ONEDRIVE_PHOTOS_FOLDER must contain date subfolders — either flat `yyyy-mm/`
# or nested `yyyy/mm/` (bare month names). That layout is what lets `scan`
# index a date range without walking the whole library. Loose files sitting
# directly in the root or a year folder are picked up too, filed by their own
# capture date.
# ONEDRIVE_METADATA_FOLDER must match VITE_ONEDRIVE_METADATA_FOLDER in app/.env;
# the app reads index.json and photos/ from there at runtime.
ONEDRIVE_PHOTOS_FOLDER=Pictures/Travel
ONEDRIVE_METADATA_FOLDER=Apps/DayArchive

# Inclusive yyyy-mm bounds limiting which month folders `scan` looks at.
# Leave both blank to scan everything. Override per-run with
# `npm run --workspace pipeline scan -- --from 2025-01 --to 2026-12`.
SCAN_MONTH_FROM=
SCAN_MONTH_TO=

# Reverse geocoding contact email (required by Nominatim's usage policy).
GEOCODE_CONTACT_EMAIL=

# Trips are defined manually in pipeline/trips.json (date ranges), not
# auto-detected — see tripDefs.ts. No env config needed here.

# ---
# Three separate commands, in increasing order of cost:
#   scan      -- indexes OneDrive into per-month shards. Graph listing calls only:
#                no photo downloads, no AI, no tokens. Run this first and often.
#   analyze   -- describes photos scan has indexed but never looked at. Downloads
#                bytes and spends tokens, so point it at a slice: `-- --month 2025-04`.
#   organize  -- groups analyzed photos into day pages with summaries + layouts.
#                Only re-summarizes days whose photo set actually changed.
