# Same Azure app registration as pipeline/.env — public client, no secret.
# These are baked into the client-side bundle at build time (Vite requires
# the VITE_ prefix); that's fine, they're not secret for a public client.
VITE_AZURE_CLIENT_ID=
VITE_AZURE_TENANT_ID=consumers

# Where the pipeline writes index.json and photos/<yyyy-mm>.json. The app
# fetches both from OneDrive at runtime, so this MUST match
# ONEDRIVE_METADATA_FOLDER in pipeline/.env.
VITE_ONEDRIVE_METADATA_FOLDER=Apps/DayArchive
