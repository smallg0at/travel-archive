{
  "name": "@travel-archive/app",
  "version": "1.0.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "preview": "vite preview",
    "cap:sync": "npm run build:mobile && npx cap sync",
    "cap:add:android": "npx cap add android",
    "cap:add:ios": "npx cap add ios",
    "build:mobile": "vite build -c vite.mobile.config.ts",
    "android:apk": "npm run cap:sync && cd android && .\\gradlew.bat assembleDebug"
  },
  "dependencies": {
    "@azure/msal-browser": "^5.21.0",
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@travel-archive/shared": "*",
    "scrypt-js": "^3.0.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "typescript": "^7.0.2",
    "vite": "^7.3.7"
  },
  "license": "AGPL-3.0-or-later"
}
