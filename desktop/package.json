{
  "name": "@travel-archive/desktop",
  "productName": "Photo Archive",
  "version": "1.1.0",
  "private": true,
  "description": "Desktop shell: serves the built app, runs the job server, opens one window.",
  "main": "dist/main.js",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.json",
    "icon": "node ../docs/brand/make-icons.mjs",
    "bundle": "node scripts/bundle-pipeline.mjs",
    "start": "electron .",
    "dist": "npm run build && npm run bundle && electron-builder"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "electron": "45.3.2",
    "electron-builder": "^26.0.12",
    "typescript": "^7.0.2"
  },
  "build": {
    "appId": "com.travelarchive.photoarchive",
    "productName": "Photo Archive",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../app/dist",
        "to": "app-dist"
      },
      {
        "from": "staging/pipeline",
        "to": "pipeline"
      },
      {
        "from": "../THIRD-PARTY-NOTICES.md",
        "to": "THIRD-PARTY-NOTICES.md"
      },
      {
        "from": "../LICENSE",
        "to": "LICENSE"
      }
    ],
    "afterPack": "scripts/after-pack.cjs",
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Photo Archive"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "smallg0at",
        "repo": "travel-archive"
      }
    ],
    "artifactName": "Photo-Archive-Setup-${version}.${ext}"
  },
  "author": "smallg0at",
  "license": "AGPL-3.0-or-later",
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
